#!/usr/bin/python3
"""hygiene-gate: the Makefile's hygiene gate, every group judged.

Runs the vendored scanner, scripts/hygiene, once over the working tree with
`--json`, and judges every group it reports: a file outside .hygiene-allow in
any group turns the gate red, each such group printed with its paths. A row
of .hygiene-allow that matches no file in the tree turns it red too, each such
row printed: an exception can outlive the file it was written for, so the list
names only what the tree holds. The rows and the tree are read
by the scanner's own functions (load_allow, glob_match, files), one computation.

The scanner reads the owner's private list from outside the repository
(`$AGENTIK_HYGIENE_PRIVATE` when set and not empty, else
`${XDG_CONFIG_HOME:-$HOME/.config}/agentik/hygiene-private.tsv`). That list is
the portfolio's, and it holds patterns that match this product's own names,
given here as WORD arguments (the Makefile's HYGIENE_OWN): for the other repos
they are private words, here they are the module path, the binary and the
platform every package is written for. Before the scan this copies the list to
a private temporary file, each line whose pattern matches a WORD whole (case
ignored) left blank, so the line numbers stay the list's, and points the
scanner at the copy. A pattern naming more than the bare word is kept. Nothing
from the list is printed, only how many lines were left out. With no readable
list the scanner runs as it is and says so itself (the generic groups only).

Usage: hygiene-gate [WORD...]
       hygiene-gate --commits RANGE [WORD...]
With --commits (hq's build order row 13; the session tool's gate land and gate
publish run it as `make hygiene-range RANGE=<a>..<b>`) the scan is of a git
revision range, not the tree: each commit's added lines, on their path, and a
new path as a line, judged by the scanner's groups and path rules and the
tree's .hygiene-allow, as the tree scan judges a file; a binary's or a UTF-16
file's new blob is read whole, as the tree scan reads it. Each line of each
message is judged under every group but sibling and renamed, and no row covers
it; a Co-Authored-By: or Signed-off-by: line of the last paragraph (never the
subject's) skips the generic email pattern alone. A merge's message is judged,
never its diff. A row of .hygiene-allow that matches no file is the tree
scan's to judge, not the range's. The owner's private list is required here (a
range read without it would read clean), applied less WORD as above. A range
git cannot read exits 2. Hits are printed by path, group and commit, never the
line.
Exit codes report the task, not the content (the agentik guide): 0 when every
group reads 0 files outside .hygiene-allow and every row matches a file, 1 when
one does not (a judged finding), 2 when the scan did not finish (the scanner
exited above 1, its JSON could not be read, the copy could not be written, or
the rows or the tree could not be read). Stdlib only.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCANNER = os.path.join(ROOT, "scripts", "hygiene")
PRIVATE_ENV = "AGENTIK_HYGIENE_PRIVATE"

# What a hit in each generic group holds; a group from the private list holds one
# of the owner's private words.
HOLDS = {
    "home": "a home directory's path",
    "lan": "a private-range address or a .local host",
    "sibling": "an agentik sibling tool's name",
    "secret": "a secret's shape",
    "email": "an email address",
    "renamed": "a name the agentik tools had before agentik-r1",
}


def private_path():
    """The scanner's own resolution of the private list's path."""
    path = os.environ.get(PRIVATE_ENV)
    if path:
        return path
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "agentik", "hygiene-private.tsv")


def own_copy(words, out):
    """Write the list to `out` with the lines naming `words` blanked; the count
    blanked, or None when there is no readable list."""
    try:
        with open(private_path(), encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except (OSError, UnicodeDecodeError):
        return None
    dropped = 0
    kept = []
    for line in lines:
        group, sep, regex = line.partition("\t")
        if sep and regex and not line.lstrip().startswith("#"):
            try:
                if any(re.fullmatch(regex, w, re.IGNORECASE) for w in words):
                    line = ""
                    dropped += 1
            except re.error:
                pass  # the scanner reports a bad line by its number, never its text
        kept.append(line)
    out.write("\n".join(kept))
    out.flush()
    return dropped


def judge(raw):
    """The red groups as [(group, [paths])], or raise ValueError on a JSON the gate cannot read."""
    doc = json.loads(raw)
    groups, rows = doc["groups"], doc["files"]
    if not isinstance(groups, dict) or not isinstance(rows, list):
        raise ValueError("unexpected shape")
    red = []
    for name in sorted(groups):
        paths = sorted(r["path"] for r in rows if r["group"] == name)
        if len(paths) != groups[name]["outside_files"]:
            raise ValueError("counts disagree")
        if paths:
            red.append((name, paths))
    return red, sorted(groups)


def dead_rows():
    """The rows of .hygiene-allow, as `glob: group,...`, whose glob matches no file the
    scanner reads; raises on a list or a tree the scanner cannot read."""
    loader = importlib.machinery.SourceFileLoader("hygiene", SCANNER)
    scanner = importlib.util.module_from_spec(importlib.util.spec_from_loader("hygiene", loader))
    loader.exec_module(scanner)
    entries = scanner.load_allow(os.path.join(ROOT, ".hygiene-allow"), False, (), False)
    tree = scanner.files(ROOT)
    return ["%s: %s" % (glob, ",".join(sorted(names))) for glob, names in entries
            if not any(scanner.glob_match(p, glob) for p in tree)]


# The range mode, `--commits RANGE`: the lines a range of commits adds and its
# messages, judged by the tree scan's groups and its .hygiene-allow (hq's build
# order row 13; the session tool's land and publish run it as `make hygiene-range`).
RANGE_MESSAGE = "(commit message)"
RANGE_MESSAGE_SKIP = ("sibling", "renamed")
RANGE_TRAILER = re.compile(r"(?:co-authored-by|signed-off-by):", re.IGNORECASE)
RANGE_BLOB_MODES = ("100644", "100755", "120000")
RANGE_ENV_DROP = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE")


class RangeFailure(Exception):
    """A read the range scan could not make: one stderr line, exit 2; its second
    argument is the git verb that failed, which names the recovery."""


def range_scanner():
    """scripts/hygiene loaded as a module: the range is judged by the scanner's own
    patterns, path rules and allow rows, one computation with the tree scan."""
    loader = importlib.machinery.SourceFileLoader("hygiene_range", SCANNER)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("hygiene_range", loader))
    loader.exec_module(module)
    return module


def range_git(*args):
    """git in ROOT, replace objects off and no GIT_DIR, GIT_WORK_TREE or
    GIT_INDEX_FILE of the caller's; its stdout as bytes, or RangeFailure."""
    env = {k: v for k, v in os.environ.items() if k not in RANGE_ENV_DROP}
    try:
        proc = subprocess.run(["git", "--no-replace-objects", "-C", ROOT] + list(args), env=env,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError as exc:
        raise RangeFailure("git could not run (%s)" % type(exc).__name__, "git") from None
    if proc.returncode != 0:
        raise RangeFailure("git %s exited %d" % (args[0], proc.returncode), args[0])
    return proc.stdout


def range_whole(scan, data):
    """A new blob's scanned lines, as the tree scan reads a file: UTF-16 decoded,
    a binary's printable runs for the scanner's binary groups, else UTF-8 text."""
    codec = scan.utf16(data)
    if codec:
        return scan.pieces(data.decode(codec, "replace"), False)
    if b"\0" in data[:scan.BINARY_PROBE]:
        return scan.pieces(data, True)
    return scan.pieces(data.decode("utf-8", "replace"), False)


def range_is_text(scan, data):
    return not scan.utf16(data) and b"\0" not in data[:scan.BINARY_PROBE]


def range_added(scan, old, new):
    """The lines a modification adds: git's -U0 diff of the two blobs where both
    read as text, else the new blob whole, as the tree scan reads it."""
    data = range_git("cat-file", "blob", new)
    if not range_is_text(scan, data) or not range_is_text(scan, range_git("cat-file", "blob", old)):
        return range_whole(scan, data)
    out, hunks = [], False
    for line in range_git("diff", "--no-color", "--no-ext-diff", "--no-textconv", "--text",
                          "-U0", old, new).split(b"\n"):
        if line.startswith(b"@@"):
            hunks = True
        elif hunks and line.startswith(b"+"):
            out.append((line[1:].decode("utf-8", "replace"), scan.ALL))
    return out


def range_changes(scan, sha):
    """[(path, [(line, groups)])] for one commit of one parent or none: each path it
    adds or modifies, with the lines it adds; a new path is a line of its own."""
    raw = range_git("diff-tree", "-r", "-z", "--no-renames", "--root", "--no-commit-id", sha)
    fields = raw.split(b"\0")
    out, i = [], 0
    while i + 1 < len(fields) and fields[i]:
        meta, path = fields[i].decode("ascii").lstrip(":").split(), fields[i + 1]
        i += 2
        old_mode, new_mode, old, new, status = meta[0], meta[1], meta[2], meta[3], meta[4][:1]
        path = path.decode("utf-8", "surrogateescape")
        if status not in ("A", "M", "T"):
            continue
        lines = [(path, scan.ALL)] if status == "A" else []
        if new_mode in RANGE_BLOB_MODES:
            if status == "M" and old_mode in RANGE_BLOB_MODES:
                lines += range_added(scan, old, new)
            else:
                lines += range_whole(scan, range_git("cat-file", "blob", new))
        out.append((path, lines))
    return out


def range_message(sha):
    """A commit's message as its paragraphs, each a list of lines."""
    raw = range_git("cat-file", "commit", sha)
    text = raw.partition(b"\n\n")[2].decode("utf-8", "replace")
    paras, para = [], []
    for line in text.split("\n"):
        if line.strip():
            para.append(line)
        elif para:
            paras.append(para)
            para = []
    if para:
        paras.append(para)
    return paras


def range_scan(scan, rng, compiled, entries):
    """{(path, group): [sha, ...]} for every hit outside .hygiene-allow in the
    range, a message's under RANGE_MESSAGE, which no row covers; and the number
    of commits read. A line counts once per group."""
    live_set = scan.live_files(scan.files(ROOT), scan.load_live(ROOT))
    generic_email = {id(rx) for name, rx in scan.COMPILED if name == "email"}
    message_rx = [(n, rx) for n, rx in compiled if n not in RANGE_MESSAGE_SKIP]
    trailer_rx = [(n, rx) for n, rx in message_rx if id(rx) not in generic_email]
    hits = {}

    def judge_line(sha, path, line, names, rxs, allowlisted):
        hit = set()
        for name, rx in rxs:
            if name in hit or (names is not scan.ALL and name not in names):
                continue
            if rx.search(line):
                hit.add(name)
        for name in hit:
            if allowlisted and scan.allowed(path, name, entries):
                continue
            shas = hits.setdefault((path, name), [])
            if sha not in shas:
                shas.append(sha)

    commits = [line.split() for line in range_git("rev-list", "--parents", rng, "--").decode("ascii").splitlines()
               if line.strip()]
    for row in commits:
        sha = row[0]
        paras = range_message(sha)
        for k, para in enumerate(paras):
            trailers = k > 0 and k == len(paras) - 1
            for line in para:
                rxs = trailer_rx if trailers and RANGE_TRAILER.match(line.strip()) else message_rx
                judge_line(sha[:12], RANGE_MESSAGE, line, scan.ALL, rxs, False)
        if len(row) > 2:
            continue  # a merge's message is scanned, never its diff: what it brings is in the range or behind it
        for path, lines in range_changes(scan, sha):
            rxs = [(name, rx) for name, rx in compiled
                   if not (name in scan.RECORDS_SKIP and path.startswith(scan.RECORDS))
                   and not (name in scan.LIVE_ONLY and path not in live_set)]
            for line, names in lines:
                judge_line(sha[:12], path, line, names, rxs, True)
    return hits, len(commits)


def range_ends(rng):
    """The revisions a range names, for its recovery line: both ends of a..b or
    a...b, an empty end read as HEAD, else the one revision less its caret."""
    for sep in ("...", ".."):
        if sep in rng:
            a, _, b = rng.partition(sep)
            return "%s %s" % (a or "HEAD", b or "HEAD")
    return rng.lstrip("^") or "HEAD"


def range_recovery(exc, rng):
    """The line that follows a range not judged: what to do, for its cause (hq
    entry 13, every refusal names its recovery)."""
    kind = type(exc).__name__
    verb = exc.args[1] if kind == "RangeFailure" and len(exc.args) > 1 else None
    if verb == "rev-list":
        return ("recover by checking that both ends of the range name commits this clone holds"
                " (git rev-parse %s), fetching what is missing, and running it again" % range_ends(rng))
    if verb == "git":
        return "recover by putting git on PATH and running it again"
    if verb:
        return ("recover by fetching the objects this clone lacks (a shallow or partial clone: git fetch, or"
                " git fetch --unshallow) and running it again")
    if kind in ("UsageError", "Failure"):
        return "recover by mending the file or the read the parenthesis names, and running it again"
    return ("recover by checking that scripts/hygiene is present and readable and runs under /usr/bin/python3,"
            " and running it again")


def range_main(rng, words):
    """The range mode's run and its exit: 0 when nothing the range adds lies outside
    .hygiene-allow, 1 when a line or a message does, 2 when the scan did not finish.
    The owner's private list is required: a range read without it is unknown."""
    if not rng or rng.startswith("-"):
        sys.stderr.write("hygiene: usage: hygiene-gate --commits RANGE [WORD...], RANGE a git revision range\n")
        return 2
    try:
        scan = range_scanner()
        with tempfile.TemporaryDirectory(prefix="hygiene-gate-") as tmp:
            path, dropped = private_path(), None
            if words:
                path = os.path.join(tmp, "private.tsv")
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w", encoding="utf-8") as out:
                    dropped = own_copy(words, out)
                if dropped is None:
                    raise scan.NoPrivateList("no readable private list")
            private = scan.load_private(path, True)
        compiled = scan.COMPILED + private
        entries = scan.load_allow(os.path.join(ROOT, ".hygiene-allow"), False,
                                  [name for name, _ in compiled], bool(private))
        hits, n = range_scan(scan, rng, compiled, entries)
    except Exception as exc:  # the scanner's UsageError, Failure and NoPrivateList, git, a read
        kind = type(exc).__name__
        if kind == "NoPrivateList":
            sys.stderr.write("hygiene: no readable private list, so the range %s was not scanned: a range is"
                             " judged against the owner's list; recover by making it readable at $%s or"
                             " the config home's agentik/hygiene-private.tsv\n" % (rng, PRIVATE_ENV))
            return 2
        said = kind in ("RangeFailure", "UsageError", "Failure") and exc.args and isinstance(exc.args[0], str)
        sys.stderr.write("hygiene: the range %s was not scanned to its end (%s), so it is not judged\n"
                         % (rng, exc.args[0] if said else kind))
        sys.stderr.write("hygiene: %s\n" % range_recovery(exc, rng))
        return 2
    names = list(dict.fromkeys(name for name, _ in compiled))
    if dropped:
        print("hygiene: the private list's %d line(s) naming this product (%s) were not applied to its words"
              % (dropped, ", ".join(words)))
        sys.stdout.flush()
    if not n:
        print("hygiene: 0 commits in the range %s, so it adds nothing to judge" % rng)
    if not hits:
        print("hygiene: the range %s, %d commit(s), adds no line outside .hygiene-allow and no message"
              " holds a hit (judged: %s)" % (rng, n, ", ".join(names)))
        return 0
    for name in names:
        rows = sorted((p, s) for (p, g), s in hits.items() if g == name)
        if not rows:
            continue
        sys.stderr.write("hygiene: the range %s adds %s in %d place(s) outside .hygiene-allow (the %s group):\n"
                         % (rng, HOLDS.get(name, "one of the private list's words"), len(rows), name))
        for p, s in rows:
            sys.stderr.write("      %s  in %s\n" % (p, ", ".join(s)))
    return 1


def main(argv):
    if argv[1:2] == ["--commits"]:
        return range_main(argv[2] if len(argv) > 2 else "", argv[3:])
    words = argv[1:]
    env = dict(os.environ)
    with tempfile.TemporaryDirectory(prefix="hygiene-gate-") as tmp:
        dropped = None
        if words:
            copy = os.path.join(tmp, "private.tsv")
            try:
                fd = os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                with os.fdopen(fd, "w", encoding="utf-8") as out:
                    dropped = own_copy(words, out)
            except OSError as exc:
                sys.stderr.write("hygiene: the private list's copy could not be written (%s), so the scan did not run\n"
                                 % type(exc).__name__)
                return 2
            if dropped is not None:
                env[PRIVATE_ENV] = copy
        proc = subprocess.run(["/usr/bin/python3", "-I", SCANNER, "--json"], cwd=ROOT, env=env,
                              stdout=subprocess.PIPE)
    if proc.returncode > 1 or proc.returncode < 0:
        sys.stderr.write("hygiene: scripts/hygiene --json exited %d, so the scan did not finish\n" % proc.returncode)
        return 2
    try:
        red, names = judge(proc.stdout.decode("utf-8"))
    except (ValueError, KeyError, TypeError, UnicodeDecodeError):
        sys.stderr.write("hygiene: the scanner's JSON could not be read, so the scan did not finish\n")
        return 2
    if bool(red) != (proc.returncode == 1):
        sys.stderr.write("hygiene: the scanner's exit %d and its JSON disagree, so the scan did not finish\n"
                         % proc.returncode)
        return 2
    try:
        dead = dead_rows()
    except Exception as exc:  # the scanner's UsageError and Failure, or its import
        sys.stderr.write("hygiene: the rows of .hygiene-allow or the tree could not be read (%s), so the scan did not finish\n"
                         % type(exc).__name__)
        return 2
    if dropped:
        print("hygiene: the private list's %d line(s) naming this product (%s) were not applied"
              % (dropped, ", ".join(words)))
        sys.stdout.flush()
    if red:
        for name, paths in red:
            sys.stderr.write("hygiene: the %s group reads %d files outside .hygiene-allow, each holding %s:\n"
                             % (name, len(paths), HOLDS.get(name, "one of the private list's words")))
            for p in paths:
                sys.stderr.write("      %s\n" % p)
    if dead:
        sys.stderr.write("hygiene: .hygiene-allow holds %d row(s) that match no file in the tree; delete each with its reason:\n"
                         % len(dead))
        for row in dead:
            sys.stderr.write("      %s\n" % row)
    if red or dead:
        return 1
    print("hygiene: every group reads 0 files outside .hygiene-allow (judged: %s)" % ", ".join(names))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
